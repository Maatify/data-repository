+declare(strict_types=1);
+
+namespace Maatify\DataRepository\Generic\Support;
+
+class FilterUtils
+{
+    /**
+     * @param   array<string, mixed>  $filters
+     *
+     * @return array{0: string, 1: array<string, mixed>}  [SQL WHERE clause, Parameters]
+     */
+    public static function buildSqlWhere(array $filters): array
+    {
+        if (empty($filters)) {
+            return ['', []];
+        }
+
+        $clauses = [];
+        $params = [];
+        $counter = 0;
+
+        foreach ($filters as $col => $val) {
+            // Validate column name security
+            if (! preg_match('/^[a-zA-Z0-9_]+$/', $col)) {
+                continue;
+            }
+
+            $paramName = "p{$counter}";
+
+            if (is_array($val)) {
+                // Handle Operators: ['age' => ['>' => 18]]
+                foreach ($val as $op => $subVal) {
+                    $op = strtoupper((string)$op);
+
+                    // Sanitize operator for param name
+                    $opSuffix = str_replace(['>', '<', '=', '!'], ['GT', 'LT', 'EQ', 'NE'], $op);
+                    $subParam = "{$paramName}_{$opSuffix}";
+
+                    if ($op === 'IN' && is_array($subVal)) {
+                        $inPlaceholders = [];
+                        foreach (array_values($subVal) as $i => $v) {
+                            $p = "{$subParam}_{$i}";
+                            $inPlaceholders[] = ":{$p}";
+                            $params[$p] = $v;
+                        }
+                        $clauses[] = "`{$col}` IN (" . implode(', ', $inPlaceholders) . ")";
+                    } elseif ($op === 'NOT IN' && is_array($subVal)) {
+                        $inPlaceholders = [];
+                        foreach (array_values($subVal) as $i => $v) {
+                            $p = "{$subParam}_{$i}";
+                            $inPlaceholders[] = ":{$p}";
+                            $params[$p] = $v;
+                        }
+                        $clauses[] = "`{$col}` NOT IN (" . implode(', ', $inPlaceholders) . ")";
+                    } elseif ($op === 'LIKE') {
+                        $clauses[] = "`{$col}` LIKE :{$subParam}";
+                        $params[$subParam] = $subVal;
+                    } elseif (in_array($op, ['>', '<', '>=', '<=', '!=', '<>'])) {
+                        $clauses[] = "`{$col}` {$op} :{$subParam}";
+                        $params[$subParam] = $subVal;
+                    }
+                }
+            } else {
+                // Standard Equality
+                $clauses[] = "`{$col}` = :{$paramName}";
+                $params[$paramName] = $val;
+            }
+            $counter++;
+        }
+
+        $sql = empty($clauses) ? '' : ' WHERE ' . implode(' AND ', $clauses);
+
+        return [$sql, $params];
+    }
+
+    /**
+     * @param   array<string, mixed>  $filters
+     *
+     * @return array<string, mixed>
+     */
+    public static function buildMongoFilter(array $filters): array
+    {
+        $mongoFilter = [];
+
+        foreach ($filters as $col => $val) {
+            if ($col === 'id') {
+                $col = '_id'; // Normalize ID for Mongo
+            }
+
+            if (is_array($val)) {
+                foreach ($val as $op => $subVal) {
+                    $op = strtoupper((string)$op);
+                    if ($op === 'IN') {
+                        $mongoFilter[$col]['$in'] = array_values((array)$subVal);
+                    } elseif ($op === 'NOT IN') {
+                        $mongoFilter[$col]['$nin'] = array_values((array)$subVal);
+                    } elseif ($op === 'LIKE') {
+                        // Regex for LIKE
+                        $mongoFilter[$col]['$regex'] = str_replace('%', '.*', (string)$subVal);
+                        $mongoFilter[$col]['$options'] = 'i'; // Case insensitive
+                    } elseif ($op === '>') {
+                        $mongoFilter[$col]['$gt'] = $subVal;
+                    } elseif ($op === '<') {
+                        $mongoFilter[$col]['$lt'] = $subVal;
+                    } elseif ($op === '>=') {
+                        $mongoFilter[$col]['$gte'] = $subVal;
+                    } elseif ($op === '<=') {
+                        $mongoFilter[$col]['$lte'] = $subVal;
+                    } elseif ($op === '!=' || $op === '<>') {
+                        $mongoFilter[$col]['$ne'] = $subVal;
+                    }
+                }
+            } else {
+                $mongoFilter[$col] = $val;
+            }
+        }
+
+        return $mongoFilter;
+    }
+}
