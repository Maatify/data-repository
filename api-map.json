{
  "project": "maatify/data-repository",
  "version": "1.1.4",
  "status": "frozen",
  "description": "Canonical Hydrated Generic Repository API with full Generic<T> support and hydrated pagination.",
  "classes": {

    "Maatify\\DataRepository\\Hydration\\HydratorInterface": {
      "type": "interface",
      "template": "T of object",
      "methods": {
        "hydrate": {
          "visibility": "public",
          "return_type": "T",
          "arguments": [
            { "name": "data", "type": "array<string, mixed>" },
            { "name": "context", "type": "?HydrationContext", "optional": true }
          ]
        },
        "hydrateAll": {
          "visibility": "public",
          "return_type": "array<T>",
          "arguments": [
            { "name": "dataset", "type": "array<int, array<string, mixed>>" },
            { "name": "context", "type": "?HydrationContext", "optional": true }
          ]
        }
      }
    },

    "Maatify\\DataRepository\\Hydration\\BaseHydrator": {
      "type": "abstract class",
      "template": "T of object",
      "implements": [
        "Maatify\\DataRepository\\Hydration\\HydratorInterface<T>"
      ],
      "methods": {
        "hydrate": {
          "visibility": "public",
          "return_type": "T",
          "arguments": [
            { "name": "data", "type": "array<string, mixed>" },
            { "name": "context", "type": "?HydrationContext", "optional": true }
          ]
        },
        "hydrateAll": {
          "visibility": "public",
          "return_type": "array<T>",
          "arguments": [
            { "name": "dataset", "type": "array<int, array<string, mixed>>" },
            { "name": "context", "type": "?HydrationContext", "optional": true }
          ]
        },
        "createInstance": {
          "visibility": "protected",
          "return_type": "T",
          "abstract": true
        }
      }
    },

    "Maatify\\DataRepository\\Base\\BaseRepository": {
      "type": "abstract class",
      "template": "T of object",
      "methods": {
        "findObject": {
          "visibility": "public",
          "return_type": "T|null",
          "arguments": [
            { "name": "id", "type": "int|string" }
          ]
        },
        "findObjectsBy": {
          "visibility": "public",
          "return_type": "array<T>",
          "arguments": [
            { "name": "filters", "type": "array<string, mixed>" }
          ]
        },
        "paginateObjects": {
          "visibility": "public",
          "return_type": "Maatify\\DataRepository\\Pagination\\HydratedPaginationCollection<T>",
          "arguments": [
            { "name": "page", "type": "int", "optional": true },
            { "name": "perPage", "type": "int", "optional": true },
            { "name": "orderBy", "type": "array<string, string>|null", "optional": true }
          ]
        },
        "paginateObjectsBy": {
          "visibility": "public",
          "return_type": "Maatify\\DataRepository\\Pagination\\HydratedPaginationCollection<T>",
          "arguments": [
            { "name": "filters", "type": "array<string, mixed>" },
            { "name": "page", "type": "int", "optional": true },
            { "name": "perPage", "type": "int", "optional": true },
            { "name": "orderBy", "type": "array<string, string>|null", "optional": true }
          ]
        }
      }
    },

    "Maatify\\DataRepository\\Pagination\\HydratedPaginationCollection": {
      "type": "class",
      "template": "T of object",
      "methods": {
        "__construct": {
          "visibility": "public",
          "arguments": [
            { "name": "data", "type": "array<T>" },
            {
              "name": "pagination",
              "type": "Maatify\\Common\\Pagination\\DTO\\PaginationDTO"
            }
          ]
        }
      }
    },

    "Maatify\\DataRepository\\Exceptions\\RedisSafetyException": {
      "type": "class",
      "extends": "Maatify\\DataRepository\\Exceptions\\RepositoryException"
    },

    "Maatify\\DataRepository\\Generic\\Support\\Safety\\RedisSafetyConfig": {
      "type": "class",
      "methods": {
        "__construct": {
          "visibility": "public",
          "arguments": [
            { "name": "maxScanKeys", "type": "int", "optional": true },
            { "name": "maxScanIterations", "type": "int", "optional": true }
          ]
        }
      }
    },

    "Maatify\\DataRepository\\Generic\\Support\\Safety\\RedisGuard": {
      "type": "class",
      "methods": {
        "__construct": {
          "visibility": "public",
          "arguments": [
            { "name": "config", "type": "Maatify\\DataRepository\\Generic\\Support\\Safety\\RedisSafetyConfig" }
          ]
        },
        "trackScan": {
          "visibility": "public",
          "arguments": [
            { "name": "newKeysFound", "type": "int" }
          ]
        }
      }
    }

  }
}
