{
  "project": "maatify/data-repository",
  "version": "1.1.2",
  "classes": {
    "Maatify\\DataRepository\\Hydration\\HydratorInterface": {
      "type": "interface",
      "template": "T of object",
      "methods": {
        "hydrate": {
          "visibility": "public",
          "return_type": "T",
          "arguments": [
            { "name": "data", "type": "array<string, mixed>", "optional": false },
            { "name": "context", "type": "?HydrationContext", "optional": true }
          ]
        },
        "hydrateAll": {
          "visibility": "public",
          "return_type": "array<T>",
          "arguments": [
            { "name": "dataset", "type": "array<int, array<string, mixed>>", "optional": false },
            { "name": "context", "type": "?HydrationContext", "optional": true }
          ]
        }
      }
    },
    "Maatify\\DataRepository\\Base\\BaseRepository": {
      "type": "abstract class",
      "template": "T of object",
      "methods": {
        "findObject": {
          "visibility": "public",
          "return_type": "T|null",
          "arguments": [
            { "name": "id", "type": "int|string", "optional": false }
          ]
        },
        "findObjectsBy": {
          "visibility": "public",
          "return_type": "array<T>",
          "arguments": [
            { "name": "filters", "type": "array<string, mixed>", "optional": false }
          ]
        },
        "paginateObjects": {
          "visibility": "public",
          "return_type": "Maatify\\DataRepository\\Pagination\\HydratedPaginationCollection<T>",
          "arguments": [
            { "name": "page", "type": "int", "optional": true },
            { "name": "perPage", "type": "int", "optional": true },
            { "name": "orderBy", "type": "array<string, string>|null", "optional": true }
          ]
        },
        "paginateObjectsBy": {
          "visibility": "public",
          "return_type": "Maatify\\DataRepository\\Pagination\\HydratedPaginationCollection<T>",
          "arguments": [
            { "name": "filters", "type": "array<string, mixed>", "optional": false },
            { "name": "page", "type": "int", "optional": true },
            { "name": "perPage", "type": "int", "optional": true },
            { "name": "orderBy", "type": "array<string, string>|null", "optional": true }
          ]
        }
      }
    },
    "Maatify\\DataRepository\\Pagination\\HydratedPaginationCollection": {
      "type": "class",
      "template": "T of object",
      "methods": {
        "__construct": {
          "visibility": "public",
          "return_type": "void",
          "arguments": [
            { "name": "data", "type": "array<T>", "optional": false },
            { "name": "pagination", "type": "Maatify\\Common\\Pagination\\DTO\\PaginationDTO", "optional": false }
          ]
        }
      }
    }
  }
}
