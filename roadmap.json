{
  "roadmap_version": "1.0.0",
  "project": "maatify/data-repository",
  "note": "Core repository runtime for the entire Maatify ecosystem. Repository must remain adapter-agnostic and behave identically across FakeAdapters and RealAdapters. This roadmap reflects 23 ultra-modular phases optimized for clean executor execution and maximum flexibility.",
  "phases": [
    {
      "id": "phase1",
      "title": "Bootstrap, Exceptions, Resolver",
      "version": "1.0.0",
      "status": "completed",
      "summary": "Project foundation, exceptions, resolver skeleton, directory structure, CI base.",
      "tasks": [
        "Initialize composer.json",
        "Setup namespace Maatify\\\\DataRepository",
        "Add RepositoryException",
        "Add RepositoryResolver",
        "Add bootstrap integration using EnvHelper",
        "Add logging entrypoints",
        "Setup PHPUnit + phpstan",
        "Initial README + CHANGELOG"
      ],
      "outputs": [
        "composer.json",
        "src/Exceptions/RepositoryException.php",
        "src/Resolver/RepositoryResolver.php",
        "README.md",
        "CHANGELOG.md"
      ],
      "tests": [
        "tests/Smoke/FakeSmokeTest.php",
        "tests/Smoke/RealSmokeTest.php"
      ]
    },
    {
      "id": "phase2",
      "title": "Base Repository Layer (MySQL, Redis, Mongo)",
      "version": "1.0.0",
      "status": "completed",
      "summary": "BaseRepository + BaseMySQL + BaseRedis + BaseMongo unifying driver access, adapter validation, and logging.",
      "tasks": [
        "Implement BaseRepository",
        "Add BaseMySQLRepository",
        "Add BaseRedisRepository",
        "Add BaseMongoRepository",
        "Normalize driver extraction",
        "AdapterInterface validation",
        "Logging hooks"
      ],
      "outputs": [
        "src/Base/BaseRepository.php",
        "src/Base/BaseMySQLRepository.php",
        "src/Base/BaseRedisRepository.php",
        "src/Base/BaseMongoRepository.php",
        "README.phase2.md"
      ],
      "tests": [
        "tests/Base/Fake/*",
        "tests/Base/Real/*"
      ]
    },
    {
      "id": "phase3",
      "title": "CRUD Layer — Basic CRUD (MySQL / Redis / Mongo)",
      "version": "1.0.1",
      "status": "completed",
      "summary": "Implement basic CRUD for three adapters with minimal filtering and result validation.",
      "tasks": [
        "Implement find, findOne, findAll",
        "Implement insert, update, delete",
        "Add minimal filters (=)",
        "Normalize primitive return formats",
        "Add basic tests for fake + real drivers"
      ],
      "outputs": [
        "src/Generic/GenericMySQLRepository.php",
        "src/Generic/GenericMongoRepository.php",
        "src/Generic/GenericRedisRepository.php",
        "README.phase3.md"
      ],
      "tests": [
        "tests/Generic/Fake/*Basic*",
        "tests/Generic/Real/*Basic*"
      ]
    },
    {
      "id": "phase4",
      "title": "Advanced Filtering",
      "version": "1.0.1",
      "status": "completed",
      "summary": "Add advanced filters: AND/OR, IN, LIKE, ranges, nested conditions.",
      "tasks": [
        "Implement IN / NOT IN / LIKE",
        "Implement range filters (> < >= <=)",
        "Add nested filters",
        "Shared filtering utilities",
        "Driver normalization (PDO/Redis/Mongo)"
      ],
      "outputs": [
        "src/Generic/Support/FilterUtils.php",
        "README.phase4.md"
      ],
      "tests": [
        "tests/Generic/Fake/Filters/*",
        "tests/Generic/Real/Filters/*"
      ]
    },
    {
      "id": "phase5",
      "title": "Ordering & Sorting",
      "version": "1.0.1",
      "status": "completed",
      "summary": "Add unified sorting (orderBy) across all adapters.",
      "tasks": [
