{
  "name": "maatify/data-repository",
  "description": "Unified repository abstraction layer normalizing MySQL, MongoDB, and Redis real drivers and fake drivers.",
  "support": {
    "issues": "https://github.com/Maatify/data-repository/issues",
    "source": "https://github.com/Maatify/data-repository",
    "docs": "https://github.com/Maatify/data-repository/tree/main/docs"
  },
  "type": "library",
  "license": "MIT",
  "keywords": [
    "maatify",
    "data-repository",
    "repository",
    "repository-pattern",
    "adapter",
    "mysql",
    "mysql-dbal",
    "mongodb",
    "mongo",
    "redis",
    "pdo",
    "phpredis",
    "predis",
    "doctrine-dbal",
    "data-layer",
    "abstraction",
    "clean-architecture",
    "design-patterns"
  ],
  "authors": [
    {
      "name": "Mohamed Abdulalim",
      "email": "mohamed@maatify.dev",
      "homepage": "https://www.maatify.dev",
      "role": "Backend Lead & Technical Architect"
    },
    {
      "name": "Maatify.dev",
      "homepage": "https://github.com/Maatify",
      "role": "Organization"
    }
  ],
  "autoload": {
    "psr-4": {
      "Maatify\\DataRepository\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\DataRepository\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": ">=8.2",
    "maatify/common": "^1.0",
    "maatify/data-adapters": "^1.0",
    "maatify/bootstrap": "^1.0",
    "maatify/psr-logger": "^1.0"
  },
  "suggest": {
    "ext-redis": "High-performance RedisAdapter.",
    "ext-pdo": "Required for MySQLAdapter (PDO driver).",
    "ext-mongodb": "Required for MongoAdapter.",
    "mongodb/mongodb": "Needed if using MongoAdapter.",
    "predis/predis": "Fallback when ext-redis is unavailable.",
    "doctrine/dbal": "Optional advanced SQL driver for MySQLDbalAdapter."
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.60",
    "mongodb/mongodb": "^2.0",
    "predis/predis": "^2.3",
    "doctrine/dbal": "^4.3",
    "maatify/data-fakes": "^1.0"
  },
  "scripts": {
    "analyse": "phpstan analyse src tests --level=max",
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:smoke": "phpunit --configuration phpunit.xml.dist --testsuite Smoke",
    "test:base": "phpunit --configuration phpunit.xml.dist --testsuite Base",
    "test:generic": "phpunit --configuration phpunit.xml.dist --testsuite Generic",
    "format": "php-cs-fixer fix"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
